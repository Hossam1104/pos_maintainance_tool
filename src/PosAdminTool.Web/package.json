{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "generate-openapi-document": "dotnet build ../PosAdminTool.Agent/PosAdminTool.Agent.csproj -c Release --nologo -v quiet",
    "generate-api-client": "npm run generate-openapi-document && ng-openapi-gen",
    "build": "npm run generate-api-client && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/run-tests.mjs",
    "lint": "ng lint",
    "e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": "24.18.0",
    "npm": "12.0.1"
  },
  "dependencies": {
    "@angular/cdk": "22.0.6",
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/platform-browser": "22.0.8",
    "@angular/router": "22.0.8",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.0.8",
    "@angular/cli": "22.0.8",
    "@angular/compiler-cli": "22.0.8",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "angular-eslint": "22.1.0",
    "eslint": "10.8.0",
    "jsdom": "28.1.0",
    "ng-openapi-gen": "1.0.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.10"
  }
}
