<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PosAdminTool.Maui.Views.LogPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PosAdminTool.Maui.Controls"
    Title="Log">
    <Grid Background="{StaticResource AppPageBackgroundBrush}">
        <Grid x:Name="AnimatedRoot" Padding="28" RowDefinitions="Auto,*" RowSpacing="16">
            <Border Style="{StaticResource HeroPanelStyle}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="10">
                            <controls:PulsingDot DotColor="{AppThemeBinding Dark={StaticResource DarkConsoleText}, Light={StaticResource LightConsoleText}}" HeightRequest="14" WidthRequest="14" />
                            <Label Style="{StaticResource EyebrowLabel}" Text="Event stream" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource PageTitleLabel}" Text="Log" />
                        <Label Style="{StaticResource SecondaryLabel}" Text="Timestamped activity from configuration, services, operations, and automation collected into a single live console." />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="10" VerticalOptions="Center">
                        <Border Style="{StaticResource StatusPillStyle}" VerticalOptions="Center">
                            <Label FontAttributes="Bold" FontSize="12" Text="Live" TextColor="{AppThemeBinding Dark={StaticResource DarkConsoleText}, Light={StaticResource LightConsoleText}}" />
                        </Border>
                        <Button Command="{Binding ClearLogCommand}" Style="{StaticResource GhostButtonStyle}" Text="Clear Log" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource ConsolePanelStyle}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Padding="18,14" ColumnDefinitions="*,Auto" BackgroundColor="{AppThemeBinding Dark={StaticResource DarkConsoleHeader}, Light={StaticResource LightConsoleHeader}}">
                        <Label FontAttributes="Bold" Text="Activity Console" TextColor="{AppThemeBinding Dark={StaticResource DarkConsoleText}, Light={StaticResource LightConsoleText}}" />
                        <Label Grid.Column="1" FontFamily="Cascadia Mono" FontSize="12" Text="scrollback" TextColor="{AppThemeBinding Dark={StaticResource DarkConsoleMeta}, Light={StaticResource LightConsoleMeta}}" />
                    </Grid>
                    <Editor
                        Grid.Row="1"
                        AutoSize="Disabled"
                        IsReadOnly="True"
                        Style="{StaticResource ConsoleEditorStyle}"
                        Text="{Binding Hub.LogText}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
