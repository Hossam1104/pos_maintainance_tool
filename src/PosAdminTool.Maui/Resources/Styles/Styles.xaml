<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <LinearGradientBrush x:Key="AppPageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{AppThemeBinding Dark={StaticResource DarkBackground}, Light={StaticResource LightBackground}}" Offset="0" />
        <GradientStop Color="{AppThemeBinding Dark={StaticResource DarkBackgroundMid}, Light={StaticResource LightBackgroundMid}}" Offset="0.55" />
        <GradientStop Color="{AppThemeBinding Dark={StaticResource DarkBackgroundEnd}, Light={StaticResource LightBackgroundEnd}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroPanelBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{AppThemeBinding Dark={StaticResource DarkHeroStart}, Light={StaticResource LightHeroStart}}" Offset="0" />
        <GradientStop Color="{AppThemeBinding Dark={StaticResource DarkHeroEnd}, Light={StaticResource LightHeroEnd}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassCardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{AppThemeBinding Dark={StaticResource DarkCardStrong}, Light={StaticResource LightCardStrong}}" Offset="0" />
        <GradientStop Color="{AppThemeBinding Dark={StaticResource DarkCard}, Light={StaticResource LightCard}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassPanelBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{AppThemeBinding Dark={StaticResource DarkCardStrong}, Light={StaticResource LightSurface}}" Offset="0" />
        <GradientStop Color="{AppThemeBinding Dark={StaticResource DarkSurfaceAlt}, Light={StaticResource LightSurfaceAlt}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StatusPillBackgroundBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{AppThemeBinding Dark={StaticResource DarkSubtleFill}, Light={StaticResource LightSubtleFill}}" Offset="0" />
        <GradientStop Color="{AppThemeBinding Dark={StaticResource DarkSurfaceAlt}, Light={StaticResource LightSurface}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ConsolePanelBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{AppThemeBinding Dark={StaticResource DarkConsoleBackground}, Light={StaticResource LightConsoleBackground}}" Offset="0" />
        <GradientStop Color="{AppThemeBinding Dark={StaticResource DarkConsoleHeader}, Light={StaticResource LightConsoleHeader}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryButtonBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentBlueStart}" Offset="0" />
        <GradientStop Color="{StaticResource AccentBlueEnd}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TealButtonBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentTealStart}" Offset="0" />
        <GradientStop Color="{StaticResource AccentTealEnd}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DangerButtonBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource DangerRedStart}" Offset="0" />
        <GradientStop Color="{StaticResource DangerRedEnd}" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource DarkText}, Light={StaticResource LightText}}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="PageTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0.2" />
        <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource DarkText}, Light={StaticResource LightText}}" />
    </Style>

    <Style x:Key="SectionTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource DarkText}, Light={StaticResource LightText}}" />
    </Style>

    <Style x:Key="SecondaryLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}" />
        <Setter Property="FontSize" Value="13" />
    </Style>


    <Style x:Key="EyebrowLabel" TargetType="Label" BasedOn="{StaticResource SecondaryLabel}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.8" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <Style x:Key="MetricValueLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource DarkText}, Light={StaticResource LightText}}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource DarkText}, Light={StaticResource LightText}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Dark={StaticResource DarkTextMuted}, Light={StaticResource LightTextMuted}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource DarkInput}, Light={StaticResource LightInput}}" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource DarkText}, Light={StaticResource LightText}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Dark={StaticResource DarkTextMuted}, Light={StaticResource LightTextMuted}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource DarkInput}, Light={StaticResource LightInput}}" />
        <Setter Property="HeightRequest" Value="42" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource DarkText}, Light={StaticResource LightText}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource DarkInput}, Light={StaticResource LightInput}}" />
    </Style>

    <Style x:Key="ConsoleEditorStyle" TargetType="Editor">
        <Setter Property="FontFamily" Value="Cascadia Mono" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource DarkConsoleText}, Light={StaticResource LightConsoleText}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource DarkConsoleBackground}, Light={StaticResource LightConsoleBackground}}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource AccentBlueStart}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="HeightRequest" Value="6" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource DarkSubtleFill}, Light={StaticResource LightSubtleFill}}" />
    </Style>

    <Style x:Key="GlassCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{StaticResource GlassCardBackgroundBrush}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Dark={StaticResource DarkCardBorder}, Light={StaticResource LightCardBorder}}" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#22000000" Offset="0,14" Radius="32" Opacity="0.24" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassPanelStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
        <Setter Property="Padding" Value="22" />
        <Setter Property="Background" Value="{StaticResource GlassPanelBackgroundBrush}" />
    </Style>

    <Style x:Key="HeroPanelStyle" TargetType="Border" BasedOn="{StaticResource GlassPanelStyle}">
        <Setter Property="Padding" Value="26" />
        <Setter Property="Background" Value="{StaticResource HeroPanelBackgroundBrush}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Dark={StaticResource DarkHeroBorder}, Light={StaticResource LightHeroBorder}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 28" />
    </Style>

    <Style x:Key="StatusPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{StaticResource StatusPillBackgroundBrush}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Dark={StaticResource DarkCardBorder}, Light={StaticResource LightCardBorder}}" />
    </Style>

    <Style x:Key="ConsolePanelStyle" TargetType="Border">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource ConsolePanelBackgroundBrush}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Dark={StaticResource DarkConsoleBorder}, Light={StaticResource LightConsoleBorder}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#22000000" Offset="0,12" Radius="28" Opacity="0.22" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerPanelStyle" TargetType="Border" BasedOn="{StaticResource GlassPanelStyle}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource DarkDangerFill}, Light={StaticResource LightDangerFill}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Dark={StaticResource DarkDangerColor}, Light={StaticResource LightDangerColor}}" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{StaticResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#220F6CBD" Offset="0,8" Radius="18" Opacity="0.26" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TealButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TealButtonBackgroundBrush}" />
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource DarkText}, Light={StaticResource LightText}}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource DarkSubtleFill}, Light={StaticResource LightSubtleFill}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Dark={StaticResource DarkCardBorder}, Light={StaticResource LightCardBorder}}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="DangerButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DangerButtonBackgroundBrush}" />
    </Style>
</ResourceDictionary>
