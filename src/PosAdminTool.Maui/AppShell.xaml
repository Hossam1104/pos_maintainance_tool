<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="PosAdminTool.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PosAdminTool.Maui"
    xmlns:views="clr-namespace:PosAdminTool.Maui.Views"
    x:Name="RootShell"
    CurrentItem="{x:Reference ConfigurationItem}"
    Title="DBS POS Admin Tool"
    BackgroundColor="{AppThemeBinding Dark={StaticResource DarkBackground}, Light={StaticResource LightBackground}}"
    FlyoutBehavior="Locked"
    FlyoutHeaderBehavior="Fixed"
    FlyoutVerticalScrollMode="Disabled"
    FlyoutWidth="304"
    ForegroundColor="{AppThemeBinding Dark={StaticResource DarkText}, Light={StaticResource LightText}}"
    Shell.BackgroundColor="{AppThemeBinding Dark={StaticResource DarkSurface}, Light={StaticResource LightSurface}}"
    Shell.FlyoutBackdrop="Transparent"
    Shell.FlyoutBackgroundColor="{AppThemeBinding Dark={StaticResource DarkShellChrome}, Light={StaticResource LightShellChrome}}"
    Shell.ForegroundColor="{AppThemeBinding Dark={StaticResource DarkText}, Light={StaticResource LightText}}"
    Shell.NavBarIsVisible="False">

    <Shell.Resources>
        <Style x:Key="RailHeaderTitleLabel" TargetType="Label" BasedOn="{StaticResource SectionTitleLabel}">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="MaxLines" Value="2" />
        </Style>

        <Style x:Key="RailHeaderBodyLabel" TargetType="Label" BasedOn="{StaticResource SecondaryLabel}">
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
    </Shell.Resources>

    <Shell.FlyoutContent>
        <Grid BackgroundColor="{AppThemeBinding Dark={StaticResource DarkShellChrome}, Light={StaticResource LightShellChrome}}">
            <CollectionView
                x:Name="FlyoutItemsView"
                BackgroundColor="Transparent"
                ItemsSource="{Binding Source={x:Reference RootShell}, Path=FlyoutEntries}"
                Margin="0,4"
                SelectionChanged="OnFlyoutSelectionChanged"
                SelectionMode="Single"
                VerticalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:ShellNavItem">
                        <Border
                            Padding="14,11"
                            Margin="12,4"
                            BackgroundColor="{AppThemeBinding Dark={StaticResource DarkSurfaceAlt}, Light={StaticResource LightSurfaceAlt}}"
                            Stroke="{AppThemeBinding Dark={StaticResource DarkCardBorder}, Light={StaticResource LightCardBorder}}"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="1">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" TargetType="Border" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource DarkSubtleFill}, Light={StaticResource LightSubtleFill}}" />
                                    <Setter Property="Stroke" Value="{StaticResource AccentBlueEnd}" />
                                    <Setter Property="StrokeThickness" Value="1.2" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Grid ColumnDefinitions="4,18,*" ColumnSpacing="12" HeightRequest="18">
                                <Border
                                    BackgroundColor="{StaticResource AccentBlueEnd}"
                                    HeightRequest="18"
                                    IsVisible="{Binding IsSelected}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999"
                                    VerticalOptions="Center"
                                    WidthRequest="4" />

                                <Label
                                    Grid.Column="1"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="16"
                                    Opacity="0.96"
                                    Text="{Binding Glyph}"
                                    TextColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}"
                                    VerticalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" TargetType="Label" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource DarkText}, Light={StaticResource LightText}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label
                                    Grid.Column="2"
                                    FontAttributes="Bold"
                                    FontFamily="Segoe UI"
                                    FontSize="14"
                                    Text="{Binding Title}"
                                    TextColor="{AppThemeBinding Dark={StaticResource DarkTextSecondary}, Light={StaticResource LightTextSecondary}}"
                                    VerticalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" TargetType="Label" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource DarkText}, Light={StaticResource LightText}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Shell.FlyoutContent>

    <Shell.FlyoutHeader>
        <Border Margin="16,20,16,12" Style="{StaticResource HeroPanelStyle}">
            <VerticalStackLayout Spacing="10">
                <Border HorizontalOptions="Start" Style="{StaticResource StatusPillStyle}">
                    <Label Style="{StaticResource EyebrowLabel}" Text="Windows Store Shell" TextColor="{StaticResource AccentBlueStart}" />
                </Border>
                <Label Style="{StaticResource RailHeaderTitleLabel}" Text="DBS POS Admin Tool" />
                <Label
                    Style="{StaticResource RailHeaderBodyLabel}"
                    Text="A persistent left navigation rail for configuration, operations, services, remote queries, and live logs." />
            </VerticalStackLayout>
        </Border>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="16,12,16,20" Spacing="8">
            <Border Style="{StaticResource StatusPillStyle}">
                <Label Style="{StaticResource SecondaryLabel}" Text="Store-style rail active" />
            </Border>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

    <ShellContent
        x:Name="ConfigurationItem"
        Route="configuration"
        Title="Configuration"
        ContentTemplate="{DataTemplate views:ConfigurationPage}">
    </ShellContent>

    <ShellContent
        x:Name="ServicesItem"
        Route="services"
        Title="Services"
        ContentTemplate="{DataTemplate views:ServicesPage}">
    </ShellContent>

    <ShellContent
        x:Name="OperationsItem"
        Route="operations"
        Title="Operations"
        ContentTemplate="{DataTemplate views:OperationsPage}">
    </ShellContent>

    <ShellContent
        x:Name="DbQueriesItem"
        Route="dbqueries"
        Title="DB Queries"
        ContentTemplate="{DataTemplate views:DbQueriesPage}">
    </ShellContent>

    <ShellContent
        x:Name="LogItem"
        Route="log"
        Title="Log"
        ContentTemplate="{DataTemplate views:LogPage}">
    </ShellContent>
</Shell>
