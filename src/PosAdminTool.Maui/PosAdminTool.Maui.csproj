<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>PosAdminTool.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationTitle>DBS POS Admin Tool</ApplicationTitle>
    <ApplicationId>com.dbs.posadmintool</ApplicationId>
    <ApplicationDisplayVersion>2.4.0</ApplicationDisplayVersion>
    <ApplicationVersion>240</ApplicationVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\Images\app_icon.svg" />
    <MauiImage Include="Resources\Images\*"
      Exclude="Resources\Images\app_icon.svg;Resources\Images\app_icon.ico" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PosAdminTool.Application\PosAdminTool.Application.csproj" />
    <ProjectReference Include="..\PosAdminTool.Domain\PosAdminTool.Domain.csproj" />
    <ProjectReference Include="..\PosAdminTool.Infrastructure\PosAdminTool.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" Version="14.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.41" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.*" />
  </ItemGroup>

</Project>