<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PosAdminTool.Maui.Controls.ServiceCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PosAdminTool.Maui.Controls"
    xmlns:converters="clr-namespace:PosAdminTool.Maui.Converters">
    <ContentView.Resources>
        <converters:ServiceStatusToColorConverter x:Key="ServiceStatusToColorConverter" />
    </ContentView.Resources>

    <Border Style="{StaticResource GlassPanelStyle}">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border
                    HeightRequest="48"
                    WidthRequest="48"
                    BackgroundColor="{AppThemeBinding Dark={StaticResource DarkSubtleFill}, Light={StaticResource LightSubtleFill}}"
                    Stroke="{Binding Status, Source={x:Reference Root}, Converter={StaticResource ServiceStatusToColorConverter}}"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="1">
                    <Grid>
                        <Label
                            FontAttributes="Bold"
                            FontSize="11"
                            CharacterSpacing="1.6"
                            HorizontalTextAlignment="Center"
                            Text="SVC"
                            TextColor="{Binding Status, Source={x:Reference Root}, Converter={StaticResource ServiceStatusToColorConverter}}"
                            VerticalTextAlignment="Center" />
                    </Grid>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        LineBreakMode="TailTruncation"
                        Text="{Binding ServiceName, Source={x:Reference Root}}" />
                    <Label Style="{StaticResource SecondaryLabel}" Text="Windows service endpoint" />
                </VerticalStackLayout>

                <Border
                    Grid.Column="2"
                    Style="{StaticResource StatusPillStyle}"
                    Stroke="{Binding Status, Source={x:Reference Root}, Converter={StaticResource ServiceStatusToColorConverter}}">
                    <HorizontalStackLayout Spacing="7">
                        <controls:PulsingDot
                            DotColor="{Binding Status, Source={x:Reference Root}, Converter={StaticResource ServiceStatusToColorConverter}}"
                            HeightRequest="10"
                            WidthRequest="10" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="{Binding Status, Source={x:Reference Root}}"
                            TextColor="{Binding Status, Source={x:Reference Root}, Converter={StaticResource ServiceStatusToColorConverter}}"
                            VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Border
                Grid.Row="1"
                Padding="0"
                BackgroundColor="{AppThemeBinding Dark={StaticResource DarkSubtleFill}, Light={StaticResource LightSubtleFill}}"
                HeightRequest="6"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 999">
                <BoxView
                    BackgroundColor="{Binding Status, Source={x:Reference Root}, Converter={StaticResource ServiceStatusToColorConverter}}"
                    CornerRadius="3"
                    HorizontalOptions="Fill" />
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button
                    Command="{Binding StartCommand, Source={x:Reference Root}}"
                    Style="{StaticResource TealButtonStyle}"
                    Text="Start" />
                <Button
                    Grid.Column="1"
                    Command="{Binding StopCommand, Source={x:Reference Root}}"
                    Style="{StaticResource GhostButtonStyle}"
                    Text="Stop" />
                <Button
                    Grid.Column="2"
                    Command="{Binding RestartCommand, Source={x:Reference Root}}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="Restart" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
